SECRET_KEY=change-me
FLASK_DEBUG=0
LLM_PROVIDER=mock # mock | openai | anthropic
LLM_MODEL= # set to the provider's model id
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=500
EMBEDDING_BACKEND=auto # auto | sentence_transformers | tfidf
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=5
RAG_USE_BM25=1
RAG_USE_RERANKER=0
CONF_MIN_TFIDF=0.10
CONF_MED_TFIDF=0.20
CONF_HIGH_TFIDF=0.35
CONF_MIN_ST=0.30
CONF_MED_ST=0.45
CONF_HIGH_ST=0.60
MAX_CHAT_CHARS=500
MAX_UPLOAD_MB=15
CHAT_RATE_LIMIT=20/minute
SEMANTIC_CACHE=1
